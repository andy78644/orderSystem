# Database
# 本地開發使用 SQLite (開發環境)
# DATABASE_URL="file:./dev.db"

# 生產環境使用 PostgreSQL
#
# === 選項 1: Vercel Postgres (推薦) ===
# Vercel 會自動設定這些環境變數，無需手動配置
# 只需在 Vercel Dashboard 建立 Postgres database 即可
POSTGRES_PRISMA_URL="postgresql://user:password@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/db"
#
# === 選項 2: Supabase / Neon / 其他 PostgreSQL ===
# 手動設定相同的變數名稱即可
# POSTGRES_PRISMA_URL="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
# POSTGRES_URL_NON_POOLING="postgresql://postgres:password@db.xxx.supabase.co:5432/postgres"
#
# === 向後兼容（舊版本）===
# 如果您的部署環境使用 DATABASE_URL，schema 會自動 fallback
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth / Session Secret
# 生成隨機密鑰：openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-key-please-change-this"

# Application URL
# 本地開發
# NEXTAUTH_URL="http://localhost:3000"
# 生產環境（部署後更新為實際 URL）
NEXTAUTH_URL="https://your-app.vercel.app"

# Admin User (預設管理員帳號，首次運行時會自動建立)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="系統管理員"
